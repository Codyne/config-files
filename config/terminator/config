[global_config]
  handle_size = 1
  borderless = True
  title_transmit_fg_color = "#1a1b26"
  title_transmit_bg_color = "#7aa2f7"
  title_receive_fg_color = "#1a1b26"
  title_receive_bg_color = "#7aa2f7"
  inactive_color_offset = 1.0
  enabled_plugins = TerminalShot, LaunchpadCode, ActivityWatch, MavenPlugin
[keybindings]
  go_up = ""
  go_down = ""
  go_left = ""
  go_right = ""
[profiles]
  [[default]]
    icon_bell = False
    cursor_color = "#aaaaaa"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_lines = 10000
  [[tokyo-night]]
    icon_bell = False
    background_color = "#1a1b26"
    background_darkness = 0.95
    background_type = transparent
    cursor_color = "#7aa2f7"
    font = Liberation Mono 10
    foreground_color = "#a9b1d6"
    show_titlebar = False
    scrollbar_position = hidden
    use_system_font = False
    copy_on_selection = True
[layouts]
  [[default]]
    [[[child0]]]
      position = 0:0
      type = Window
      order = 0
      parent = ""
      size = 1100, 700
    [[[child1]]]
      profile = tokyo-night
      position = 0:0
      type = Terminal
      order = 0
      parent = child0
      size = 1100, 700
[plugins]
