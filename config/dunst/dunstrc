[global]
    ### Display ###
    monitor = 0
    follow = mouse
    width = 350
    height = 5 + 7
    offset = 10x10
    origin = top-right
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#7aa2f7"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Text ###
    font = Liberation Mono 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    icon_position = left
    max_icon_size = 32
    icon_path = /usr/share/icons/Tokyo-Night/16x16/status/:/usr/share/icons/Tokyo-Night/48x48/status/:/usr/share/icons/Adwaita/48x48/status/

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    dmenu = /usr/bin/rofi -dmenu -p dunst: -theme ~/.config/rofi/tokyo-night.rasi
    browser = /usr/bin/firefox -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst
    startup_notification = false
    force_xinerama = false

    ### Shortcuts ###
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#24283b"
    foreground = "#7c84a6"
    timeout = 8
    frame_color = "#7c84a6"

[urgency_normal]
    background = "#24283b"
    foreground = "#a9b1d6"
    timeout = 10
    frame_color = "#7aa2f7"

[urgency_critical]
    background = "#24283b"
    foreground = "#f7768e"
    timeout = 0
    frame_color = "#f7768e"

# vim: ft=cfg
