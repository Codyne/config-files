# i3blocks config file
#
# Please see man i3blocks for a complete reference!
# The man page is also hosted at http://vivien.github.io/i3blocks
#
# List of valid properties:
#
# align
# color
# command
# full_text
# instance
# interval
# label
# min_width
# name
# separator
# separator_block_width
# short_text
# signal
# urgent

# Global properties
#
# The top properties below are applied to every block, but can be overridden.
# Each block command defaults to the script name to avoid boilerplate.
#command=/usr/lib/i3blocks/$BLOCK_NAME
command=~/.config/i3blocks/$BLOCK_NAME/$BLOCK_NAME
separator_block_width=15
markup=none

# [apt-upgrades]
# signal=1
# interval=once
# PENDING_SYMBOL="⟳ "
# SYMBOL_ONLY=0
# ALWAYS_PRINT=1
# PENDING_COLOR="#00FF00"
# NONPENDING_COLOR="#FFFFFF"

[bandwidth3]
label=ETH
interval=persist
markup=pango

[ip]
command=hostname -i | awk '{ print "IP:" $1 }'
interval=once
#color=#91E78B

[load_average]
label=LOAD
interval=10

[disk]
label=DISK
instance=/
interval=30

[memory]
label=MEM
interval=30

# [cpu_usage]
# label=CPU
# interval=10
#min_width=CPU 100.00%

[cpu_usage2]
markup=pango
interval=persist

# [cpu_util_detailed]
# label=CPU2
# markup=pango
# interval=-2

[volume-pulseaudio]
#command=/volume-pulseaudio
interval=once
signal=1

[dunst]
interval=once
format=json
markup=pango

[weather_NOAA]
interval=600
LAT=0.0
LON=0.0

[calendar]
interval=1
label=

